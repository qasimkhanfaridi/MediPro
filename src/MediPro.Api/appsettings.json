{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=MediPro.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173",
      "http://127.0.0.1:4173"
    ]
  },
  "Jwt": {
    "Issuer": "MediPro",
    "Audience": "MediPro",
    "SigningKey": "LOCAL_ONLY_REPLACE_WITH_USER_SECRETS_OR_ENV_VAR_32CHARS_MIN",
    "ExpiryMinutes": 120
  },
  "DevSeed": {
    "Enabled": false,
    "AdminEmail": "admin@medipro.local",
    "AdminPassword": ""
  },
  "Inventory": {
    "HideStoreStockQuantity": true,
    "AutoDecrementOnOrder": false,
    "EnforceStockQuantityCap": false
  },
  "Notifications": {
    "EmailEnabled": false,
    "AdditionalAdminEmails": [],
    "AppBaseUrl": "http://localhost:5173",
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseStartTls": true,
    "FromEmail": "noreply@medipro.local",
    "FromDisplayName": "MediPro",
    "PendingStoreReminderHours": 24,
    "PendingStoreReminderEnabled": true,
    "ReminderCheckIntervalMinutes": 15,
    "WhatsAppEnabled": false,
    "CallMeBotPhone": "",
    "CallMeBotApiKey": ""
  }
}
